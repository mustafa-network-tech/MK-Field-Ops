    },
    {
      "source": "/kullanim-sartlari",
      "destination": "/kullanim-sartlari/index.html"
    },
    {
      "source": "/geri-odeme-politikasi",
      "destination": "/geri-odeme-politikasi/index.html"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/register",
      "destination": "/app.html"
    },
    {
      "source": "/workspace",
      "destination": "/app.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/app.html"
    },
    {
      "source": "/reset-password",
      "destination": "/app.html"
    },
    {
      "source": "/plan-and-payment",
      "destination": "/app.html"
    },
    {
